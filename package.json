{
  "name": "azwrap-ts",
  "version": "0.1.0",
  "description": "TypeScript wrapper for Azure SDKs - simplifies interaction with Azure services",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "azwrap": "./dist/bin/azwrap.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "azure",
    "sdk",
    "wrapper",
    "typescript",
    "blob-storage",
    "table-storage",
    "ai-search",
    "openai",
    "document-intelligence"
  ],
  "author": "ckifonidis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckifonidis/azwrap-ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/arm-resources": "^5.0.0",
    "@azure/arm-subscriptions": "^5.0.0",
    "@azure/arm-storage": "^18.0.0",
    "@azure/storage-blob": "^12.17.0",
    "@azure/data-tables": "^13.2.0",
    "@azure/arm-search": "^3.0.0",
    "@azure/search-documents": "^12.0.0",
    "@azure/arm-cognitiveservices": "^7.0.0",
    "@azure/ai-form-recognizer": "^5.0.0",
    "openai": "^4.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0"
  }
}
